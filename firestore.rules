rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // 1. Applications collection (School apps directory)
    // Public read so all students, teachers, and visitors can browse the catalog
    // Write permitted for portal management
    match /applications/{appId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. Global Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Access Logs collection (Audit trail)
    match /access_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // 6. Test connection probe
    match /test/connection {
      allow read, write: if true;
    }
  }
}
